APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/legalrisk
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=legal-risk
JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=720
DEFAULT_MODEL=nlpaueb/legal-bert-base-uncased
INFER_MAX_LENGTH=1024
INFER_STRIDE=128
INFER_THRESHOLD=0.5
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
HUGGINGFACE_HUB_TOKEN=
OPENAI_API_KEY=
